#!/usr/bin/env python3
"""Outline a Markdown file so an agent can read one section instead of the whole file.

Claude Code's Read refuses a file over about 256 KB or 25,000 tokens unless it is given an
offset and a limit, and QMD indexes only wiki/, so a large raw/ capture has no map. This
prints one line per heading: its first and last line, its size in bytes, and the heading.
A section runs to the line before the next heading of the same or a higher level, so it
includes its subsections. Read it with offset=<first> and limit=<last - first + 1>.

YAML frontmatter at the top of the file is skipped and reported, not outlined. Headings
inside fenced code blocks are ignored. ATX (`## Title`) and setext (a line underlined with
`===` or `---`) headings are both recognised; HTML headings are not.

Standard library only, so it runs without .venv. Exit 0: outlined. Exit 2: bad arguments or
a file that cannot be read as UTF-8 text.
"""
import json
import re
import sys
from pathlib import Path

USAGE = "usage: md-outline <file.md> [--json]"
ATX = re.compile(r" {0,3}(#{1,6})(?:[ \t]+(.*?))?(?:[ \t]+#+)?[ \t]*$")
FENCE = re.compile(r" {0,3}(`{3,}|~{3,})")
SETEXT = re.compile(r" {0,3}(=+|-+)[ \t]*$")
# A line that cannot be the text of a setext heading: a list item, quote, or other block.
NOT_PARAGRAPH = re.compile(r" {0,3}(?:[-+*>]|\d{1,9}[.)])(?:[ \t]|$)| {4}|\t")


def fail(message):
    sys.stderr.write(f"md-outline: {message}\n")
    raise SystemExit(2)


def frontmatter_end(lines):
    """Index of the closing frontmatter line, or -1 when the file has no frontmatter."""
    if not lines or lines[0].rstrip("\r\n") != "---":
        return -1
    for index, line in enumerate(lines[1:], start=1):
        if line.rstrip("\r\n") in ("---", "..."):
            return index
    return -1


def headings(lines, start):
    """Yield (index, level, title) for each heading at or after lines[start]."""
    fence = None
    previous = None  # the paragraph line a setext underline would turn into a heading
    for index in range(start, len(lines)):
        line = lines[index].rstrip("\r\n")
        opener = FENCE.match(line)
        if fence:
            if opener and opener.group(1)[0] == fence[0] and len(opener.group(1)) >= len(fence) \
                    and not line.strip().strip(fence[0]):
                fence = None
            continue
        if opener and not (opener.group(1)[0] == "`" and "`" in line.strip()[len(opener.group(1)):]):
            fence, previous = opener.group(1), None
            continue
        atx = ATX.match(line)
        if atx:
            yield index, len(atx.group(1)), (atx.group(2) or "").strip()
            previous = None
            continue
        underline = SETEXT.match(line)
        if underline:
            if previous is not None:
                yield previous[0], 1 if underline.group(1)[0] == "=" else 2, previous[1]
            previous = None  # with no paragraph above, a --- line is a thematic break
            continue
        if not line.strip() or NOT_PARAGRAPH.match(line):
            previous = None
        elif previous is None:
            previous = (index, line.strip())


def outline(path):
    try:
        data = path.read_bytes()
        text = data.decode("utf-8-sig")
    except (OSError, UnicodeDecodeError) as error:
        fail(f"{path}: {error}")
    lines = text.splitlines(keepends=True)
    offsets = [0]
    for line in lines:
        offsets.append(offsets[-1] + len(line.encode("utf-8")))
    front = frontmatter_end(lines)
    found = list(headings(lines, front + 1))
    sections, open_sections = [], []  # open_sections: indexes into sections, by level
    for index, level, title in found + [(len(lines), 0, None)]:
        while open_sections and sections[open_sections[-1]]["level"] >= level:
            section = sections[open_sections.pop()]
            section["last"] = index
            section["bytes"] = offsets[index] - offsets[section["first"] - 1]
        if title is not None:
            open_sections.append(len(sections))
            sections.append({"level": level, "title": title, "first": index + 1})
    return {"path": str(path), "lines": len(lines), "bytes": len(data),
            "frontmatter": [1, front + 1] if front >= 0 else None, "sections": sections}


def main(argv):
    args = [a for a in argv if a != "--json"]
    if len(args) != 1 or args[0].startswith("-"):
        fail(USAGE)
    result = outline(Path(args[0]))
    if "--json" in argv:
        print(json.dumps(result, ensure_ascii=False))
        return
    front = result["frontmatter"]
    print(f"{result['path']}: {result['lines']} lines, {result['bytes']} bytes"
          + (f"; frontmatter lines {front[0]}-{front[1]} skipped" if front else ""))
    if not result["sections"]:
        print("no headings")
    for section in result["sections"]:
        span = f"{section['first']}-{section['last']}"
        print(f"{span:>15} {section['bytes']:>10}  {'#' * section['level']} {section['title']}")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except BrokenPipeError:  # a reader such as head closed the pipe; the outline was not needed
        sys.stderr.close()
