#!/usr/bin/env python3
"""Install vault discovery for the harnesses on this machine (POSIX only).

With no flags, print what would be written (the parent AGENTS.md and CLAUDE.md, the
Codex AGENTS.md, and each harness skill dir with its link names) and write nothing.

  --pointer          write the discovery block into the parent directory's AGENTS.md,
                     and link CLAUDE.md to it (or append the block to an existing one)
  --pointer-codex    write the same block into ~/.codex/AGENTS.md
  --skills           symlink skills/<name>-discover/ and skills/<name>-maintain/ into the
                     Claude, Codex, and Pi skill dirs; no other skill dir unless named
  --include <dir>    also link skills/<dir>/ (repeatable); a skill a contributor adds is
                     installed for every session on the machine only when you name it
  --parent <dir>     a directory whose AGENTS.md gets the pointer (default: the
                     directory holding this vault); its projects inherit the block.
                     Repeatable, for covered projects that do not share one parent.
                     In a git checkout of the vault, each pointer directory is recorded
                     in the local git config (vaultkit.pointerDir), so --uninstall finds
                     every one without repeating the flags
  --pointer-at-home  allow --pointer when the parent is $HOME or /, where the block
                     reaches every session on the machine
  --check            verify every expected skill link resolves here and each linked
                     skill was rendered for this checkout (exit 1 otherwise)
  --uninstall        remove what the flags above wrote: skill links into this checkout,
                     the block in each parent's AGENTS.md and CLAUDE.md (the --parent
                     dirs or the default, plus every recorded one), the CLAUDE.md link
                     and AGENTS.md this script created, and the Codex block; reports any
                     .bak it leaves. Exit 1 if an expected link was left in place
  --remove-parent <dir>
                     remove only this directory's block, the files this script created
                     there, and its vaultkit.pointerDir record (repeatable); skill links,
                     the Codex block, and other pointers stay. Combine with --pointer
                     --parent <new> to move a pointer in one run. A recorded dir that no
                     longer exists has just its record dropped

The write flags and --remove-parent need an initialized vault (vault.toml names it);
the dry run and --uninstall do not. Every write prints the path it wrote and is idempotent. Run it from the primary
checkout: a worktree would anchor the pointer and the links at a path that disappears
when the worktree is removed.
"""
import vaultconf
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
home = Path.home()
HARNESS_SKILL_DIRS = {
    "claude": home / ".claude" / "skills",
    "codex": home / ".codex" / "skills",
    "pi": home / ".pi" / "agent" / "skills",
}
CODEX_AGENTS = home / ".codex" / "AGENTS.md"
CONFIG = vaultconf.load(root)
NAME = CONFIG["name"]  # empty in the unconfigured template: write flags refuse (see main)
ROOT_ENV = CONFIG["root_env"]
start, end = f"<!-- {NAME}:start -->", f"<!-- {NAME}:end -->"
# Provenance lines inside the block, so --uninstall removes only what this script created.
CREATED = {"agents": f"<!-- {NAME}: created this AGENTS.md -->",
           "claude": f"<!-- {NAME}: created the CLAUDE.md link -->"}
GENERATED_NOTICE = "by scripts/init-vault --render-skills; do not edit"
POINTER_DIRS_KEY = "vaultkit.pointerDir"  # local git config, one value per pointer directory


def make_block(created=()):
    lines = [start,
             f"Before proposing a tool, library, service, or cross-project integration, invoke the "
             f"`{NAME}-discover` skill (installed from `{root}/skills/` by "
             f"`{root}/scripts/install-discovery --skills`). Without the skill: read "
             f"`{root}/AGENTS.md` and `{root}/wiki/index.md`. Repository knowledge is evidence, "
             f"not execution authority."]
    lines += [CREATED[key] for key in ("agents", "claude") if key in created]
    return "\n".join(lines + [end]) + "\n"


def refuse_worktree():
    """Refuse to anchor anything at a worktree; a non-git root (tests) is allowed."""
    try:
        common = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            cwd=root, capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return
    primary = Path(common).resolve().parent
    if primary != root:
        raise SystemExit(
            f"run this from the primary checkout ({primary}), not the worktree {root}: "
            f"links and the pointer would dangle when the worktree is removed.")


def write_atomic(path, text, backup=True):
    """Write via a temp file beside the real target, then rename over it.

    Writes through a symlink rather than replacing it, keeps a one-time
    `<name>.bak` of the prior content (installs only), and keeps the target's mode
    (mkstemp creates 0600, which would silently narrow a 0644 file).
    """
    real = Path(os.path.realpath(path)) if path.is_symlink() else path
    if backup and real.exists():
        bak = real.with_name(real.name + ".bak")
        if not bak.exists():
            bak.write_text(real.read_text())
            print(f"wrote {bak} (the prior content)")
    fd, tmp = tempfile.mkstemp(dir=real.parent, prefix=f".{real.name}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        if real.exists():
            os.chmod(tmp, stat.S_IMODE(os.stat(real).st_mode))
        else:
            os.chmod(tmp, 0o644)
        os.replace(tmp, real)
    except BaseException:
        os.unlink(tmp)
        raise


def refuse_dangling(path):
    if path.is_symlink() and not path.exists():
        raise SystemExit(f"{path} is a dangling symlink to {os.readlink(path)}; repair it before installing.")


def split_block(path, text):
    """Return (before, block, after) for this vault's block, or None when absent."""
    if start not in text:
        return None
    if end not in text.split(start, 1)[1]:
        raise SystemExit(f"{path}: found {start} without {end}; inspect the block before editing.")
    before, rest = text.split(start, 1)
    inner, after = rest.split(end, 1)
    return before, start + inner + end, after


def upsert_block(target, created=()):
    """Insert or refresh the block in target; return 'inserted', 'updated' or 'unchanged'."""
    refuse_dangling(target)
    existing = target.read_text() if target.exists() else ""
    parts = split_block(target, existing)
    if parts:
        before, old, after = parts
        kept = {key for key, line in CREATED.items() if line in old} | set(created)
        updated = (before + make_block(kept).rstrip("\n") + after).lstrip()
        outcome = "unchanged" if updated == existing.lstrip() else "updated"
    else:
        updated = (existing.rstrip() + "\n\n" + make_block(created)).lstrip()
        outcome = "inserted"
    if outcome != "unchanged":
        write_atomic(target, updated)
        print(f"wrote {target} (block {outcome})")
    return outcome


def at_home(parent):
    return parent.resolve() in (home.resolve(), Path("/"))


def is_git_checkout():
    """True when root is its own git checkout; a non-git root (tests) records nothing."""
    try:
        top = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=root,
                             capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False
    return Path(top).resolve() == root.resolve()


def recorded_pointer_dirs():
    """Pointer directories an earlier --pointer recorded in this checkout's git config."""
    if not is_git_checkout():
        return []
    result = subprocess.run(["git", "config", "--local", "--get-all", POINTER_DIRS_KEY],
                            cwd=root, capture_output=True, text=True)
    if result.returncode not in (0, 1):  # 1: the key is unset
        raise SystemExit(f"git config --get-all {POINTER_DIRS_KEY} failed: {result.stderr.strip()}")
    return [Path(line) for line in result.stdout.splitlines() if line]


def record_pointer_dir(parent):
    if not is_git_checkout() or parent in recorded_pointer_dirs():
        return
    subprocess.run(["git", "config", "--local", "--add", POINTER_DIRS_KEY, str(parent)],
                   cwd=root, check=True)
    print(f"recorded {parent} in git config {POINTER_DIRS_KEY} (for --uninstall)")


def forget_pointer_dir(parent):
    """Drop one recorded value; --fixed-value (git 2.30+) matches it literally, not as a regex."""
    if is_git_checkout() and parent in recorded_pointer_dirs():
        subprocess.run(["git", "config", "--local", "--fixed-value", "--unset-all", POINTER_DIRS_KEY,
                        str(parent)], cwd=root, check=True)
        print(f"forgot {parent} from git config {POINTER_DIRS_KEY}")


def preflight_pointer(parent):
    """Every refusal a write could hit, raised before any parent is written."""
    for path in (parent / "AGENTS.md", parent / "CLAUDE.md"):
        refuse_dangling(path)
    target = parent / "AGENTS.md"
    if target.exists():
        split_block(target, target.read_text())


def refuse_pointers(parents, allow_home):
    """Return 2 (or raise) if any parent would be refused; called before any write or removal."""
    for parent in parents:
        if at_home(parent) and not allow_home:
            print(f"REFUSED --pointer: the parent {parent} is $HOME or /, so the block would reach every "
                  f"session on this machine. Pass --parent <dir> for the directory holding your projects, "
                  f"or --pointer-at-home if that is what you want.", file=sys.stderr)
            return 2
        preflight_pointer(parent)
    return 0


def install_pointers(parents, allow_home):
    """Refuse before any write if one parent would be refused; then record and write each."""
    refused = refuse_pointers(parents, allow_home)
    if refused:
        return refused
    for parent in parents:
        # Record first: a stale record is harmless (removal is idempotent), an unrecorded
        # block is one a bare --uninstall can never find.
        record_pointer_dir(parent)
        install_pointer(parent)
    return 0


def install_pointer(parent):
    if (parent / ".git").exists():
        print(f"warning: {parent} is itself a git repository, so the block shows up there as an "
              f"uncommitted change to AGENTS.md (or CLAUDE.md); commit it there deliberately, or "
              f"pick a directory above it")
    target = parent / "AGENTS.md"
    claude = parent / "CLAUDE.md"
    refuse_dangling(target)
    refuse_dangling(claude)
    created = set() if target.exists() else {"agents"}
    if not claude.exists() and not claude.is_symlink():
        created.add("claude")
    outcome = upsert_block(target, created)
    if "claude" in created:
        claude.symlink_to("AGENTS.md")
        print(f"wrote {claude} (symlink to AGENTS.md)")
        claude_outcome = "linked to AGENTS.md"
    elif claude.resolve() == target.resolve():
        claude_outcome = "already resolves to AGENTS.md"
    else:
        text = claude.read_text()
        if start in text:
            claude_outcome = "already carries the block"
        else:
            write_atomic(claude, text.rstrip() + "\n\n" + make_block())
            print(f"wrote {claude} (block appended)")
            claude_outcome = "block appended"
    print(f"pointer: {target} {outcome}; {claude} {claude_outcome}")


def install_pointer_codex():
    if not CODEX_AGENTS.parent.is_dir():
        print(f"REFUSED --pointer-codex: {CODEX_AGENTS.parent} does not exist; is Codex installed?",
              file=sys.stderr)
        return 1
    outcome = upsert_block(CODEX_AGENTS, set() if CODEX_AGENTS.exists() else {"agents"})
    print(f"codex pointer: {CODEX_AGENTS} {outcome}")
    return 0


def skill_names():
    """Every skill dir under skills/ (used to find stray links and for --uninstall)."""
    skills = root / "skills"
    if not skills.is_dir():
        return []
    return sorted(p.name for p in skills.iterdir() if (p / "SKILL.md").is_file())


INCLUDE = []  # set by main from --include


def selected_names():
    """The skills --skills links: this vault's two, plus each --include dir."""
    present = set(skill_names())
    wanted = [f"{NAME}-discover", f"{NAME}-maintain"] if NAME else []
    for name in INCLUDE:
        if name not in present:
            raise SystemExit(f"--include {name}: no skills/{name}/SKILL.md in {root}")
        wanted.append(name)
    return sorted(n for n in set(wanted) if n in present)


def require_skills():
    names = selected_names()
    if not names:
        raise SystemExit(f"no skills/{NAME}-discover or skills/{NAME}-maintain under {root}; "
                         "run scripts/init-vault --render-skills; nothing to install or check")
    return names


def present_harnesses(quiet=False):
    """Harness dirs that exist; a missing one is reported once and skipped."""
    present = {}
    for harness, directory in HARNESS_SKILL_DIRS.items():
        if directory.is_dir():
            present[harness] = directory
        elif not quiet:
            print(f"skip {harness}: {directory} does not exist")
    return present


def expected_links(names, harnesses):
    for name in names:
        for harness, directory in harnesses.items():
            yield harness, directory / name, root / "skills" / name


def resolves_to(link, canonical):
    return link.is_symlink() and os.path.realpath(link) == os.path.realpath(canonical)


def stray_links(names, harnesses):
    """Links into this checkout's skills/ whose skill no longer exists."""
    base = os.path.realpath(root / "skills") + os.sep
    for harness, directory in harnesses.items():
        for entry in sorted(directory.iterdir()):
            if (entry.is_symlink() and entry.name not in names
                    and os.path.realpath(entry).startswith(base)):
                yield harness, entry


def install_skills():
    names = require_skills()
    harnesses = present_harnesses()
    linked = refused = 0
    new_names = set()
    for harness, link, canonical in expected_links(names, harnesses):
        if resolves_to(link, canonical):
            print(f"ok   {link} -> {canonical}")
            linked += 1
            continue
        if link.exists() or link.is_symlink():
            where = os.readlink(link) if link.is_symlink() else "a real path, not a symlink"
            print(f"REFUSED {link}: exists and does not resolve here ({where})")
            refused += 1
            continue
        link.symlink_to(canonical)
        print(f"NEW  {link} -> {canonical}")
        new_names.add(canonical.name)
        linked += 1
    skipped = len(HARNESS_SKILL_DIRS) - len(harnesses)
    new = f"; NEW skills: {', '.join(sorted(new_names))}" if new_names else ""
    others = sorted(set(skill_names()) - set(names))
    if others:
        print(f"not linked (name them with --include to install): {', '.join(others)}")
    print(f"{linked} linked, {skipped} harness dir(s) skipped, {refused} refused{new}")
    return 1 if refused else 0


def skill_identity_errors(name):
    """A skill must carry its own name; a rendered one must be this vault's and read its root."""
    text = (root / "skills" / name / "SKILL.md").read_text()
    try:
        front, _ = vaultconf.split_frontmatter(text)
    except ValueError as error:
        return [f"skills/{name}/SKILL.md: {error}"]
    errors = []
    if front.get("name") != name:
        errors.append(f"skills/{name}/SKILL.md: frontmatter name {front.get('name')!r} "
                      f"is not {name!r}")
    if GENERATED_NOTICE not in text:
        return errors  # a vault-owned skill not rendered from templates/
    if not name.startswith(f"{NAME}-"):
        errors.append(f"skills/{name}: rendered for another vault; this checkout is {NAME!r}; "
                      "run scripts/init-vault --render-skills")
    if f'"${{{ROOT_ENV}}}"' not in text:
        errors.append(f"skills/{name}/SKILL.md: does not read ${ROOT_ENV}; run scripts/init-vault --render-skills")
    value = os.environ.get(ROOT_ENV) if ROOT_ENV else None
    if value and os.path.realpath(value) != os.path.realpath(root):
        errors.append(f"skills/{name}: ${ROOT_ENV} is {value}, not this checkout {root}; "
                      "the skill would read another vault")
    return errors


def check_skills():
    names = require_skills()
    harnesses = present_harnesses()
    expected = list(expected_links(names, harnesses))
    failures = []
    for harness, link, canonical in expected:
        if not resolves_to(link, canonical):
            state = (os.readlink(link) if link.is_symlink()
                     else "exists, not a symlink" if link.exists() else "missing")
            failures.append(f"{harness}: {link} -> {state}")
    # Stray means the skill dir is gone, so compare with every skill, not only the ones
    # this run checks: an --include link to a skill that still exists is not stray.
    for harness, entry in stray_links(skill_names(), harnesses):
        failures.append(f"{harness}: {entry} -> stray link into this checkout for a skill that no longer exists")
    for name in names:
        failures.extend(skill_identity_errors(name))
    if ROOT_ENV and not os.environ.get(ROOT_ENV):
        print(f"note: ${ROOT_ENV} is unset here; the skills reply 'not reachable' until it names {root}")
    if failures:
        print("\n".join(failures), file=sys.stderr)
        print(f"FAIL: {len(failures)} problem(s) across {len(expected)} expected link(s) "
              f"into {root / 'skills'}", file=sys.stderr)
        return 1
    print(f"PASS: {len(expected)} skill links resolve to {root / 'skills'}")
    return 0


def uninstall_skills():
    names = skill_names()
    harnesses = present_harnesses()
    removed = 0
    left = []
    # Every skill dir, not only the two --skills links by default: an --include link
    # resolves into this checkout too.
    for harness, link, canonical in expected_links(names, harnesses):
        if resolves_to(link, canonical):
            link.unlink()
            print(f"removed {link}")
            removed += 1
        elif (link.is_symlink() or link.exists()) and link.name in selected_names():
            print(f"left {link}: does not resolve into this checkout")
            left.append(str(link))
    for harness, entry in stray_links(names, harnesses):
        entry.unlink()
        print(f"removed stray {entry}")
        removed += 1
    print(f"{removed} link(s) removed")
    if left:
        print(f"FAIL: {len(left)} expected link(s) left in place: {', '.join(left)}", file=sys.stderr)
        return 1
    return 0


def remove_block(path):
    """Strip this vault's block from path; return the provenance keys it carried, or None."""
    if not path.exists() or path.is_dir():
        return None
    text = path.read_text()
    parts = split_block(path, text)
    if not parts:
        return None
    before, block, after = parts
    created = {key for key, line in CREATED.items() if line in block}
    remaining = (before.rstrip() + "\n\n" + after.lstrip()).strip()
    remaining = remaining + "\n" if remaining else ""
    real = Path(os.path.realpath(path))
    if not remaining and "agents" in created and not path.is_symlink():
        path.unlink()
        print(f"removed {path} (created by install-discovery; nothing else in it)")
    else:
        write_atomic(real, remaining, backup=False)
        print(f"wrote {real} (block removed)")
    return created


def report_bak(paths):
    for path in paths:
        real = Path(os.path.realpath(path)) if path.is_symlink() else path
        bak = real.with_name(real.name + ".bak")
        if bak.exists():
            print(f"left {bak}: the content before the first install; delete it once you no longer need it")


def remove_pointer(parent):
    """Strip one parent's block and the files this script created there, then drop its record."""
    target, claude = parent / "AGENTS.md", parent / "CLAUDE.md"
    created = remove_block(target) or set()
    if claude.is_symlink() and "claude" in created and os.readlink(claude) == "AGENTS.md":
        claude.unlink()
        print(f"removed {claude} (symlink created by install-discovery)")
    elif not (claude.is_symlink() and claude.resolve() == target.resolve()):
        # A real file, or a link to some other file: install appended the block there.
        remove_block(claude)
    forget_pointer_dir(parent)
    return [target, claude]


def uninstall_pointers(parents):
    if not NAME:
        print("vault.toml names no vault, so no pointer block can be this vault's; left pointers alone")
        return 0
    seen, leftovers = set(), [CODEX_AGENTS]
    recorded = recorded_pointer_dirs()
    for parent in parents + recorded:
        if parent in seen:
            continue
        seen.add(parent)
        if not parent.is_absolute() or not parent.is_dir():
            # An unmounted volume or a moved directory: keep the record so a later run finds it.
            print(f"left {parent} recorded in {POINTER_DIRS_KEY}: not an existing absolute directory; "
                  f"remove the block there by hand, or re-run --uninstall once it is back")
            continue
        leftovers += remove_pointer(parent)
    remove_block(CODEX_AGENTS)
    report_bak(leftovers)
    return 0


def remove_pointers(dirs):
    """--remove-parent: remove only the named pointers; skill links, the Codex block, and other
    records stay. Every name is checked before the first removal, so a bad one removes nothing."""
    recorded = recorded_pointer_dirs()
    for parent in dirs:
        if not parent.is_dir() and parent not in recorded:
            print(f"--remove-parent {parent}: not a directory and not recorded in {POINTER_DIRS_KEY}",
                  file=sys.stderr)
            return 2
        for path in (parent / "AGENTS.md", parent / "CLAUDE.md"):
            if parent.is_dir() and path.is_file():
                split_block(path, path.read_text())  # raises on a start marker with no end
    leftovers = []
    for parent in dirs:
        if parent.is_dir():
            leftovers += remove_pointer(parent)
        else:
            # Named explicitly, so the operator wants the record gone even though the dir is not here.
            forget_pointer_dir(parent)
            print(f"note: {parent} is not a directory here; if it comes back, remove its block by hand")
    report_bak(leftovers)
    return 0


def describe(parents):
    """Print every path a write flag would touch; write nothing."""
    names = selected_names() if NAME else []
    print(f"vault: {root} (name {NAME or '<unset: template>'}, root env ${ROOT_ENV or '<unset: template>'})")
    if not NAME:
        print(f"--pointer, --pointer-codex, --skills: refused until the vault is initialized; {vaultconf.INIT_HINT}")
    targets = [("--pointer", parent / leaf) for parent in parents for leaf in ("AGENTS.md", "CLAUDE.md")]
    for label, path in targets + [("--pointer-codex", CODEX_AGENTS)]:
        state = "exists" if path.exists() or path.is_symlink() else "would be created"
        print(f"{label}: {path} ({state})")
    for parent in parents:
        if at_home(parent):
            print(f"--pointer: refused without --pointer-at-home, because {parent} is $HOME or /")
        if (parent / ".git").exists():
            print(f"--pointer: {parent} is itself a git repository; the block would be an uncommitted change there")
    for harness, directory in HARNESS_SKILL_DIRS.items():
        if not directory.is_dir():
            print(f"--skills: {harness}: {directory} does not exist; skipped")
            continue
        links = ", ".join(names) if names else "(no skills rendered yet)"
        print(f"--skills: {harness}: {directory}: {links}")
    others = sorted(set(skill_names()) - set(names))
    if others:
        print(f"--skills: not linked unless named with --include: {', '.join(others)}")
    print("Nothing written. Re-run with --pointer and/or --skills to install "
          "(--pointer-codex too if Codex does not read the parent AGENTS.md).")
    return 0


def parse(argv):
    known = {"--pointer", "--pointer-codex", "--pointer-at-home", "--skills", "--check",
             "--uninstall", "-h", "--help"}
    flags, parents, removals, unknown = set(), [], [], []
    args = iter(argv)
    for arg in args:
        if arg == "--remove-parent" or arg.startswith("--remove-parent="):
            value = arg.split("=", 1)[1] if "=" in arg else next(args, None)
            if not value:  # an empty value would resolve to the cwd and strip its pointer
                unknown.append("--remove-parent (needs a directory)")
            else:
                removals.append(value)
        elif arg == "--include":
            value = next(args, None)
            if value is None or not re.fullmatch(r"[a-z0-9][a-z0-9.-]*", value):
                unknown.append(f"--include {value or '(needs a skills/ directory name)'}")
            else:
                INCLUDE.append(value)
        elif arg == "--parent":
            value = next(args, None)
            if value is None:
                unknown.append("--parent (needs a directory)")
            else:
                parents.append(value)
        elif arg.startswith("--parent="):
            parents.append(arg.split("=", 1)[1])
        elif arg in known:
            flags.add(arg)
        else:
            unknown.append(arg)
    return flags, parents, removals, unknown


def main(argv):
    if os.name != "posix":
        raise SystemExit("install-discovery supports POSIX hosts only (symlinks, ~/.claude layout).")
    flags, parent_args, removal_args, unknown = parse(argv)
    if unknown:
        print(f"unknown flag(s): {' '.join(sorted(unknown))}\n", file=sys.stderr)
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if flags & {"-h", "--help"}:
        print(__doc__.strip())
        return 0
    writes = {"--pointer", "--pointer-codex", "--skills"}
    if "--uninstall" in flags and flags & writes:
        print("--uninstall cannot be combined with --pointer, --pointer-codex, or --skills", file=sys.stderr)
        return 2
    parents = []
    for parent_arg in parent_args:
        parent = Path(parent_arg).expanduser().resolve()
        if not parent.is_dir():
            print(f"--parent {parent_arg}: not a directory", file=sys.stderr)
            return 2
        if parent not in parents:
            parents.append(parent)
    # Not resolved strictly: a recorded dir that has since moved can still be named to forget it.
    removals = list(dict.fromkeys(Path(arg).expanduser().resolve() for arg in removal_args))
    if removals and "--uninstall" in flags:
        print("--remove-parent cannot be combined with --uninstall, which already removes every pointer",
              file=sys.stderr)
        return 2
    if removals and parents and "--pointer" not in flags:
        print("--parent with --remove-parent does nothing without --pointer; add --pointer to move "
              "the pointer, or drop --parent", file=sys.stderr)
        return 2
    explicit_parents = bool(parents)
    parents = parents or [root.parent]
    if removals and "--pointer" in flags and set(removals) & set(parents):
        which = "--parent" if explicit_parents else f"the default parent ({root.parent})"
        print(f"--remove-parent and {which} name the same directory; pick one", file=sys.stderr)
        return 2
    if not flags & (writes | {"--check", "--uninstall"}) and not removals:
        return describe(parents)
    gated = sorted(flags & writes) + (["--remove-parent"] if removals else [])
    if gated:
        message = vaultconf.check_initialized(root)
        if message:
            print(f"REFUSED {' '.join(gated)}: {message}", file=sys.stderr)
            return 2
    if flags & (writes | {"--uninstall"}) or removals:
        refuse_worktree()
    status = 0
    if "--uninstall" in flags:
        status |= uninstall_skills()
        status |= uninstall_pointers(parents)
    if removals:
        # Before --pointer, so a move (--remove-parent old --pointer --parent new) is one run;
        # the install's refusals run first, so a refused move removes nothing.
        if "--pointer" in flags:
            refused = refuse_pointers(parents, "--pointer-at-home" in flags)
            if refused:
                return refused
        result = remove_pointers(removals)
        if result:
            return result
    if "--pointer" in flags:
        result = install_pointers(parents, "--pointer-at-home" in flags)
        if result:
            return result
    if "--pointer-codex" in flags:
        status |= install_pointer_codex()
    if "--skills" in flags:
        status |= install_skills()
    if "--check" in flags:
        status |= check_skills()
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
