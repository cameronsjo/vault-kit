#!/usr/bin/env python3
"""Run gitleaks pinned by version and SHA-256; pass every argument through.

Resolution order (scripts/pinnedbin.py, shared with scripts/vale):
  1. GITLEAKS_BIN: an operator-installed gitleaks. `<bin> version` must print the pinned
     version, or the wrapper exits 2; GITLEAKS_ALLOW_UNPINNED=1 runs another version (or
     any executable) with a loud warning. CI never sets it.
  2. A verified copy under ${XDG_CACHE_HOME:-$HOME/.cache}/vault-kit/gitleaks-<version>/.
  3. A download of the pinned release archive, verified before it is unpacked.
     GITLEAKS_DOWNLOAD_BASE replaces the release URL (a mirror); checksums still apply.

Checksum mismatch exits 2. No usable binary exits 2: the scan fails closed, never open.
`scripts/gitleaks --vault-resolve` prints the verified binary's path and runs nothing.
"""
import vaultconf  # noqa: F401  (toolchain preflight)
import sys

VERSION = "8.30.1"
RELEASE = f"https://github.com/gitleaks/gitleaks/releases/download/v{VERSION}"
# archive: from gitleaks_<VERSION>_checksums.txt on the release.
# binary: SHA-256 of the gitleaks file inside that verified archive, re-checked every run.
PINNED = {
    "darwin_arm64": {
        "archive": "b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5",
        "binary": "ba52fb1bfabbcde42f032afad3d6e0b19dff8ed105229a16e7caa338bbc0e84f",
    },
    "darwin_x64": {
        "archive": "dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709",
        "binary": "cee01fea7173f1b779dff188e1c26ecbcb4027d394acc573b23aaf0be260e291",
    },
    "linux_x64": {
        "archive": "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb",
        "binary": "88f91962aa2f93ac6ab281d553b9e125f5197bbbce38f9f2437f7299c32e5509",
    },
}
INSTALL_HINT = (f"Install gitleaks {VERSION} (https://github.com/gitleaks/gitleaks/releases/tag/v{VERSION}, "
                "or your package manager), then set GITLEAKS_BIN to its path and retry. "
                "The secret scan fails closed: nothing was scanned.")

try:
    import pinnedbin
except ImportError as error:  # exit 2, never 1: scan-secrets.py reads 1 as "leaks found"
    print(f"gitleaks wrapper: cannot load scripts/pinnedbin.py ({error}). {INSTALL_HINT}", file=sys.stderr)
    raise SystemExit(2)

SPEC = pinnedbin.ToolSpec(
    name="gitleaks", version=VERSION, release_url=RELEASE,
    archives={key: f"gitleaks_{VERSION}_{key}.tar.gz" for key in PINNED}, pins=PINNED,
    env_prefix="GITLEAKS", version_args=("version",), version_output=VERSION,
    install_hint=INSTALL_HINT, allow_unpinned_env="GITLEAKS_ALLOW_UNPINNED",
    closed_note="The secret scan fails closed: nothing was scanned.")


if __name__ == "__main__":
    pinnedbin.main(SPEC, sys.argv[1:], unavailable_exit=2)
